 "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "assign", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "When do you think they are going to", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "asine", "type": "text"}]}, {"type": "post_question", "contents": {"content": "our new supervisor?", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"value": {"images": [{"text": "", "image": "engenn8le06ob04re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong notdialogue\">The Mock Interview</span>  <br/> <br/>Dear Readers, <br/>\nRecently, I've been receiving many questions about the kinds of questions that are asked in job interviews. I decided to set up a mock interview to cover the basics for you.  Here is the transcript of the interview.<br><br>", "image": "engenn8le06ob04re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Interviewer</span>: Good afternoon, Ms. Davis. It's nice to meet you.<br/>\n<span class=\"strong\">Sally</span>: It's nice to meet you, too. <br/>\n<span class=\"strong\">Interviewer</span>: Before we begin, this is a copy of our non-disclosure agreement. Please read it over and sign and date the last page.<br/>\n<span class=\"strong\">Sally</span>: Certainly.", "image": "engenn8le06ob04re2img01.jpg", "time": "15000", "id": 2}, {"text": "<span class=\"strong\">Interviewer</span>: Great, thank you. So, I see you've done some travel in foreign countries. Are you comfortable traveling for work?<br/>\n<span class=\"strong\">Sally</span>: Absolutely. I love to travel and my home schedule is quite flexible - I don't have any obligations.<br/>\n<span class=\"strong\">Interviewer</span>: Why did you resign from your previous job?<br/>\n<span class=\"strong\">Sally</span>: Well, my manager's goals for the company did not align with mine in the best way. I thought it best to step down and allow room for someone who is a better fit.", "image": "engenn8le06ob04re2img01.jpg", "time": "27700", "id": 3}, {"text": "<span class=\"strong\">Interviewer</span>: Tell me about your role there.<br/>\n<span class=\"strong\">Sally</span>: I was in charge of the design and development of their new cologne marketing campaign. I was also assigned as the head QA. <br/>\n<span class=\"strong\">Interviewer</span>: I see. Do you have any questions for me?<br/>\n<span class=\"strong\">Sally</span>: Yes. Does the company offer opportunities for professional development? <br/>\n<span class=\"strong\">Interviewer</span>: Absolutely. We have workshops and seminars three times a year.", "image": "engenn8le06ob04re2img02.jpg", "time": "52300", "id": 4}, {"text": "<span class=\"strong\">Interviewer</span>: It was a pleasure meeting you. I will be in touch by the end of the week.<br/>\n<span class=\"strong\">Sally</span>: Thank you very much for the opportunity. Good bye.", "image": "engenn8le06ob04re2img01.jpg", "time": "73200", "id": 5}], "coverimg": "engenn8le06ob04re2img05.jpg", "audiosrc": "engenn8le06ob04re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Tales from the Workplace", "type": "lesson_name"}, {"content": "Answering Questions", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about people's backgrounds using a wider range of language.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level.", "type": "secondary_8"}]}, {"content": "engenn8le06ob04re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Silent Letter <span class=\"italic\">g</span>", "type": "heading"}, {"content": "You don't say every letter in a word in English pronunciation. Some letters are <span class=\"strong\">silent</span>, which means that you don't hear them as you would pronounce them normally.", "type": "describer"}, {"content": "Here are examples of the <span class=\"strong\">silent</span> letter <span class=\"italic\">g</span> in words. Practice saying the example sentences.", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Words\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">sign</span></p>Pronounced: <br/> \u201csain\u201d\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Please read it over and sign and date the last page.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">foreign</span></p>Pronounced: <br/> \u201cforin\u201d\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I see you've done some travel in foreign countries. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">resign</span></p>Pronounced: <br/>\\\"rizain\\\"\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Why did you resign from your previous job?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">align</span></p>Pronounced: <br/> \\\"alain\\\"\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My and my manager's goals for the company did not align in the best way.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">design</span></p>Pronounced:<br/>\u201cdizain\\\"\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I was in charge of design and development.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<p><span class=\\\"italic\\\">assign</span></p>Pronounced:<br/>\\\"asain\\\"\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I was also assigned as the head QA. </span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "Other words that have the <span class=\"strong\">silent</span><span class=\"italic\"> g</span> are:", "type": "text"}, {"content": "<span class=\"italic\">cologne</span> \u201cka lone\u201d<br/> <span class=\"italic\">campaign</span> \u201ccam pain\u201d<br/> <span class=\"italic\">champagne</span> \u201csham pain\u201d<br/> <span class=\"italic\">reign</span> \u201crain\u201d<br/> <span class=\"italic\">diaphragm</span> \u201cdia fram\u201d<br/>", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Breaking Sentences into Parts", "type": "heading"}, {"content": "When you read or speak in English, you often \u201cchunk\u201d or break the sentence into parts based on the meaning contained in each part. Each chunk is a phrase that has meaning (containing content words). You do not chunk between function words (like articles, pronouns, prepositions etc).  ", "type": "describer"}, {"content": "Breaking sentences or questions into parts makes it easier for you to say them and easier for the listener to hear the ideas contained in the sentence.", "type": "text"}, {"content": "For example, look at the sentence: ", "type": "text"}, {"content": "<span class=\"italic\">I was in charge of the design and development of their new cologne marketing campaign. </span>", "type": "text"}, {"content": "This sentence could be chunked or broken into the following parts:", "type": "text"}, {"content": "<span class=\"italic\">I was in charge of the design  <br/>and development <br/> of their new cologne marketing campaign.</span>", "type": "text"}, {"content": "I thought it best*to step down*and allow room*for someone who is a better fit.", "type": "example"}, {"content": "Well,*my manager's goals for the company*did not align with mine* in the best way.", "type": "example"}, {"content": "Does the company offer*opportunities for professional development?", "type": "example"}, {"content": "It CANNOT be chunked this way, since it needs to be separated into meaningful pieces of language: ", "type": "text"}, {"content": "<span class=\"italic\">I was in <br/> charge of the <br/> design  <br/>and development  of their<br/> new <br/>cologne <br/>marketing <br/>campaign.</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "non-disclosure agreement", "type": "name"}, {"content": "an agreement between you and a company that states you will not tell other people company secrets", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Before we begin, this is a copy of our non-disclosure agreement.", "type": "example"}, {"content": "engenn8le06ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about jobs and work.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to date", "type": "name"}, {"content": "to write the date on an official document", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Please read it over and sign and date the last page.", "type": "example"}, {"content": "engenn8le06ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to resign", "type": "name"}, {"content": "to voluntarily leave a job", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Why did you resign from your previous job?", "type": "example"}, {"content": "engenn8le06ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to assign", "type": "name"}, {"content": "to give a task to someone", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I was also assigned as the head the department. ", "type": "example"}, {"content": "engenn8le06ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "professional development", "type": "name"}, {"content": "the act of improving your professional skills", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Does the company offer opportunities for professional development?", "type": "example"}, {"content": "engenn8le06ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "QA", "type": "name"}, {"content": "short for \"quality assurance\"", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I was also assigned as the head QA.", "type": "example"}, {"content": "engenn8le06ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mock", "type": "name"}, {"content": "pretend", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I decided to set up a mock interview.", "type": "example"}, {"content": "engenn8le06ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cologne ", "type": "name"}, {"content": "men's perfume", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I was in charge of the design and development of their new cologne.", "type": "example"}, {"content": "engenn8le06ob04aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "campaign ", "type": "name"}, {"content": "an organized course of action to achieve a particular goal", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I was in charge of the design and development of their marketing campaign. ", "type": "example"}, {"content": "engenn8le06ob04aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "the basics", "type": "name"}, {"content": "the essential facts or principles of a skill", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I decided to set up a mock interview to cover the basics for you.", "type": "example"}, {"content": "engenn8le06ob04aud10", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Imagine that you are hiring a new employee at your company.", "type": "text"}, {"content": "Write some questions that you would like to ask a potential employee in an interview. Be sure to use some words with a silent <span class=\"strong\">g</span>!", "type": "text"}, {"content": "With a partner, practice the interview. Ask your partner the questions you wrote. ", "type": "text"}, {"content": "Switch roles. Your partner will ask you interview questions and you can answer them.", "type": "text"}, {"content": "Practice interviewing each other until you feel confident!", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use and pronounce words like <span class=\"italic\">sign</span>.", "type": "text"}, {"content": "I talk about jobs, work, manners and customs.", "type": "text"}, {"content": "I use proper intonation and stress in long questions and sentences.", "type": "text"}, {"content": "I interview a partner and answer interview questions.", "type": "text"}]}]}