}], "selected": 0}], "id": 1, "_data": [{"type": "question", "contents": [{"content": "engenn8le06ob04re6aud03", "type": "audio"}]}, {"content": "secondary_7", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "I&nbsp;resigned from&nbsp;my&nbsp;previous&nbsp;job * because&nbsp;I&nbsp;wanted more&nbsp;of a&nbsp;challenge * and&nbsp;I wanted&nbsp;to work * at&nbsp;a&nbsp;more progressive&nbsp;company.", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "I&nbsp;resigned", "type": "text"}], "selected": 0}, {"id": 2, "correct": 1, "_data": [{"content": "from&nbsp;my&nbsp;previous&nbsp;job", "type": "text"}], "selected": 0}, {"id": 3, "correct": 1, "_data": [{"content": "*", "type": "text"}], "selected": 0}, {"id": 4, "correct": 1, "_data": [{"content": "because&nbsp;I&nbsp;wanted", "type": "text"}], "selected": 0}, {"id": 5, "correct": 1, "_data": [{"content": "more&nbsp;of", "type": "text"}], "selected": 0}, {"id": 6, "correct": 1, "_data": [{"content": "a&nbsp;challenge", "type": "text"}], "selected": 0}, {"id": 7, "correct": 1, "_data": [{"content": "*", "type": "text"}], "selected": 0}, {"id": 8, "correct": 1, "_data": [{"content": "and&nbsp;I", "type": "text"}], "selected": 0}, {"id": 9, "correct": 1, "_data": [{"content": "wanted&nbsp;to", "type": "text"}], "selected": 0}, {"id": 10, "correct": 1, "_data": [{"content": "work", "type": "text"}], "selected": 0}, {"id": 11, "correct": 1, "_data": [{"content": "*", "type": "text"}], "selected": 0}, {"id": 12, "correct": 1, "_data": [{"content": "at&nbsp;a&nbsp;more", "type": "text"}], "selected": 0}, {"id": 13, "correct": 1, "_data": [{"content": "progressive&nbsp;company.", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "engenn8le06ob04re6aud04", "type": "audio"}]}, {"content": "secondary_7", "type": "objective"}]}], "stimuli_ids": [], "id": 9, "template_override": 1}, {"type": "GIW", "_data": [{"type"